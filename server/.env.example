# Copy to server/.env (git-ignored). Leave SUPABASE_URL empty to keep sign-in OFF (demo mode).
# Supabase dashboard > Project Settings > API
SUPABASE_URL=
# Optional. Only for projects still on the legacy JWT secret (HS256). Leave empty for the new signing keys.
SUPABASE_JWT_SECRET=
# Only for scripts/create-demo-users.mjs. Secret: never put it in web/.env.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=

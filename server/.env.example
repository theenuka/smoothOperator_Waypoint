# Copy to server/.env (git-ignored). Required: the server will not start without SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Supabase dashboard > Project Settings > API
SUPABASE_URL=
# Optional. Only for projects still on the legacy JWT secret (HS256). Leave empty for the new signing keys.
SUPABASE_JWT_SECRET=
# The server uses it to read and write the database, and scripts/create-demo-users.mjs to make accounts. Secret: never put it in web/.env.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=
